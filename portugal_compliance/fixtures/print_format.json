  "doctype": "Print Format",
  "font": null,
  "font_size": 14,
  "format_data": null,
  "html": "\n<div style=\"font-family: Arial, sans-serif; font-size: 11px; color: #222; line-height: 1.4;\">\n\n    <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 14px;\">\n        <tr>\n            <td style=\"width: 55%; vertical-align: top;\">\n                <div style=\"font-weight: bold; font-size: 12px;\">{{ doc.company }}</div>\n                {% if doc.company_address %}<div>{{ frappe.get_doc(\"Address\", doc.company_address).get_display() | replace(\"\\n\", \"<br>\") | safe }}</div>{% endif %}\n                <div><strong>Contribuinte:</strong> {{ get_company_nif(doc.company) }}</div>\n            </td>\n            <td style=\"width: 45%; vertical-align: top; text-align: left; padding-left: 40%;\">\n                <div style=\"font-weight: bold;\">{{ doc.customer_name or doc.customer }}</div>\n                {% if doc.address_display %}<div>{{ doc.address_display | safe }}</div>{% endif %}\n            </td>\n        </tr>\n    </table>\n\n    <table style=\"width: 100%; border-collapse: collapse; border-top: 1px solid #333; border-bottom: 1px solid #333; margin-bottom: 10px;\">\n        <tr>\n            <td style=\"width: 70%; vertical-align: top; padding: 8px 0; font-size: 15px; font-weight: bold;\">\n                {{ get_document_type_description(doc.doctype) or doc.doctype }} n.º {{ doc.name }}\n            </td>\n            <td style=\"width: 30%; vertical-align: top; text-align: right; padding: 8px 0; font-size: 9px;\">\n                Original - ATCUD: {{ get_atcud_code(doc) or \"-\" }}<br>\n                {% set qr_data = get_qr_code_data(doc=doc) %}\n                {% if qr_data %}<table style=\"width: 70px; margin-top: 4px; margin-left: auto; border-collapse: collapse;\"><tr><td style=\"width: 70px; height: 70px; padding: 0;\"><img src=\"{{ generate_qr_code_image(qr_data, 150) }}\" width=\"70\" height=\"70\" style=\"width: 70px !important; height: 70px !important; max-width: none !important; display: block;\"></td></tr></table>{% endif %}\n            </td>\n        </tr>\n    </table>\n\n    <table style=\"width: 100%; border-collapse: collapse; border-top: 1px solid #ccc; border-bottom: 1px solid #ccc; margin-bottom: 14px; font-size: 10px;\">\n        <tr>\n            <td style=\"width: 25%; padding: 6px 4px 6px 0;\"><strong>Data</strong><br>{{ format_portuguese_date(doc.posting_date) }}</td>\n            <td style=\"width: 25%; padding: 6px 4px;\"><strong>Vencimento</strong><br>{{ format_portuguese_date(doc.due_date) if doc.due_date else \"-\" }}</td>\n            <td style=\"width: 25%; padding: 6px 4px;\"><strong>Contribuinte</strong><br>{{ doc.tax_id or \"Consumidor final\" }}</td>\n            <td style=\"width: 25%; padding: 6px 0 6px 4px;\"><strong>V/ Ref.</strong><br>{{ doc.po_no or \"-\" }}</td>\n        </tr>\n    </table>\n\n    {% if doc.terms %}\n    <div style=\"font-size: 10px; margin-bottom: 10px;\"><strong>Observações:</strong> {{ doc.terms }}</div>\n    {% endif %}\n\n    {% set exemption_notes = namespace(codes=[]) %}\n    <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 6px;\">\n        <thead>\n            <tr style=\"border-bottom: 1px solid #333; text-align: left;\">\n                <th style=\"padding: 4px;\">Código</th>\n                <th style=\"padding: 4px;\">Descrição</th>\n                <th style=\"padding: 4px; text-align: right;\">P. Uni.</th>\n                <th style=\"padding: 4px; text-align: right;\">Uni.</th>\n                <th style=\"padding: 4px; text-align: right;\">Qtd.</th>\n                <th style=\"padding: 4px; text-align: right;\">IVA</th>\n                <th style=\"padding: 4px; text-align: right;\">Total</th>\n            </tr>\n        </thead>\n        <tbody>\n            {% for item in doc.items %}\n            <tr style=\"border-bottom: 1px solid #eee;\">\n                <td style=\"padding: 4px;\">{{ item.item_code }}</td>\n                <td style=\"padding: 4px;\">{{ item.item_name or item.item_code }}</td>\n                <td style=\"padding: 4px; text-align: right;\">{{ format_portuguese_currency(item.rate) }}</td>\n                <td style=\"padding: 4px; text-align: right;\">{{ item.uom or \"\" }}</td>\n                <td style=\"padding: 4px; text-align: right;\">{{ item.qty }}</td>\n                <td style=\"padding: 4px; text-align: right;\">\n                    {%- set item_rate = get_item_effective_tax_rate(item, doc) -%}\n                    {{ (item_rate ~ \"%\") if item_rate is not none else \"-\" }}\n                    {%- if item.at_exemption_reason -%}\n                        {%- if item.at_exemption_reason not in exemption_notes.codes -%}\n                            {%- set _ = exemption_notes.codes.append(item.at_exemption_reason) -%}\n                        {%- endif -%}\n                        <sup>({{ exemption_notes.codes.index(item.at_exemption_reason) + 1 }})</sup>\n                    {%- endif -%}\n                </td>\n                <td style=\"padding: 4px; text-align: right;\">{{ format_portuguese_currency(item.amount) }}</td>\n            </tr>\n            {% endfor %}\n        </tbody>\n    </table>\n    <div style=\"margin-bottom: 14px;\">\n    {% if exemption_notes.codes %}\n    <div style=\"font-size: 9px; color: #555;\">\n        {% for code in exemption_notes.codes %}\n        <div>({{ loop.index }}) {{ code }}{% set reason = frappe.db.get_value(\"AT Tax Exemption\", code, \"description\") %}{% if reason %} - {{ reason }}{% endif %}</div>\n        {% endfor %}\n    </div>\n    {% endif %}\n    </div>\n\n    {% set breakdown = get_tax_breakdown_by_at_code(doc) %}\n    <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 14px;\">\n        <tr>\n            <td style=\"width: 55%; vertical-align: top;\">\n                <table style=\"border-collapse: collapse; font-size: 10px; width: 100%;\">\n                    <thead>\n                        <tr style=\"border-bottom: 1px solid #333; text-align: left;\">\n                            <th style=\"padding: 4px;\">Taxa</th>\n                            <th style=\"padding: 4px; text-align: right;\">Base</th>\n                            <th style=\"padding: 4px; text-align: right;\">IVA</th>\n                            <th style=\"padding: 4px; text-align: right;\">Total</th>\n                        </tr>\n                    </thead>\n                    <tbody>\n                        {% for label, code in [(\"Normal\", \"NOR\"), (\"Intermédia\", \"INT\"), (\"Reduzida\", \"RED\"), (\"Isenta\", \"ISE\")] %}\n                            {% set b = breakdown[code] %}\n                            {% if b.base or b.tax %}\n                            {% set pct = ((b.tax / b.base * 100) | round | int) if b.base else 0 %}\n                            <tr style=\"border-bottom: 1px solid #eee;\">\n                                <td style=\"padding: 4px; white-space: nowrap;\">{{ label }} ({{ pct }}%)</td>\n                                <td style=\"padding: 4px; text-align: right; white-space: nowrap;\">{{ format_portuguese_currency(b.base) }}</td>\n                                <td style=\"padding: 4px; text-align: right; white-space: nowrap;\">{{ format_portuguese_currency(b.tax) }}</td>\n                                <td style=\"padding: 4px; text-align: right; white-space: nowrap;\">{{ format_portuguese_currency(b.base + b.tax) }}</td>\n                            </tr>\n                            {% endif %}\n                        {% endfor %}\n                    </tbody>\n                </table>\n            </td>\n            <td style=\"width: 45%; vertical-align: top;\">\n                <table style=\"width: 100%; font-size: 10px;\">\n                    <tr><td style=\"padding: 2px 8px 2px 0;\">S/IVA:</td><td style=\"text-align: right; white-space: nowrap;\">{{ format_portuguese_currency(doc.net_total) }}</td></tr>\n                    <tr><td style=\"padding: 2px 8px 2px 0;\">IVA:</td><td style=\"text-align: right; white-space: nowrap;\">{{ format_portuguese_currency(doc.total_taxes_and_charges) }}</td></tr>\n                    <tr style=\"font-weight: bold;\"><td style=\"padding: 4px 8px 2px 0; border-top: 1px solid #333;\">Total:</td><td style=\"text-align: right; white-space: nowrap; border-top: 1px solid #333; padding-top: 4px;\">{{ format_portuguese_currency(doc.grand_total) }}</td></tr>\n                </table>\n            </td>\n        </tr>\n    </table>\n\n    <table style=\"width: 100%; border-collapse: collapse; border-top: 1px solid #333; font-size: 9px; color: #555;\">\n        <tr>\n            <td style=\"padding-top: 8px;\">\n                Código Único de Documento (ATCUD), gerado automaticamente conforme Portaria n.º 195/2020.<br>\n                Processado por programa informático certificado n.º {{ frappe.db.get_single_value(\"Portugal Auth Settings\", \"software_certificate_number\") or \"0\" }}/AT{% if frappe.db.get_single_value(\"Portugal Auth Settings\", \"sandbox_mode\") %} — AMBIENTE DE TESTES, sem valor fiscal{% endif %}.\n            </td>\n        </tr>\n    </table>\n\n</div>\n",
